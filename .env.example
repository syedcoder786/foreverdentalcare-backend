# Copy to `.env` in this folder. It is read by Spring Boot (locally) and by docker-compose.prod.yml (on the server).
# Never commit the real .env file.

# ---- Database (Supabase PostgreSQL) ----
# Supabase dashboard -> Connect -> "Session pooler". Use the pooler host: it works over IPv4, while the direct
# db.<project-ref>.supabase.co host is IPv6-only. The username includes the project ref.
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=change-me
# Schema that holds the clinic tables (created by Flyway on first start). Keeps them out of Supabase's public Data API.
DB_SCHEMA=dental_clinic
DB_SSL_MODE=require
# The Session pooler allows only a few connections per project; keep this small.
DB_POOL_SIZE=5
# Another Supabase database chosen in Admin -> Database (test, connect, copy data) is saved to this file and overrides
# the DB_* values above. Use "Go back to .env database" in the admin panel (or delete the file) to return to them.
# DB_CONFIG_FILE=./db-connection.json

# ---- Security ----
# At least 32 characters. Generate e.g. with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
# true in production (HTTPS). false only for local http development.
COOKIE_SECURE=false

# Initial admin account - created on first start ONLY if no admin exists.
# Change the password after first login / remove these afterwards.
ADMIN_NAME=Clinic Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# ---- App ----
SERVER_PORT=8080
# Comma separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Clinic local timezone (IANA id). All appointment dates/times are interpreted in this zone.
APP_TIMEZONE=Asia/Kolkata

# Rate limits (requests per window per client IP)
RATE_LIMIT_BOOKING_PER_HOUR=10
RATE_LIMIT_LOGIN_PER_MINUTE=5

# ---- Image storage ----
# "local" (disk, UPLOAD_DIR) or "cloudinary"
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
# Required when STORAGE_PROVIDER=cloudinary. Find it in the Cloudinary console (API Keys). Keep it secret.
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>
CLOUDINARY_FOLDER=forever-dental-care
# Storage chosen in Admin -> Image storage (Cloudinary keys entered there) is saved to this file and overrides the
# values above. Delete the file (or use "Go back to .env settings" in the admin panel) to return to them.
# STORAGE_CONFIG_FILE=./storage-connection.json

# ---- Patient sign-in (WhatsApp code) ----
# WhatsApp credentials are entered in Admin -> Settings -> WhatsApp sign-in, not here.
# DEVELOPMENT ONLY: true writes sign-in codes to the backend log while WhatsApp is not set up.
OTP_LOG_CODES=false
# How long patients stay signed in (days)
PATIENT_SESSION_DAYS=30
