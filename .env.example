# Copy to `.env` (repo root, used by docker-compose) AND `backend/.env` (used by Spring Boot).
# Never commit the real .env files.

# ---- Database ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dental_clinic
DB_USERNAME=dental_user
DB_PASSWORD=change-me-strong-db-password

# ---- Security ----
# At least 32 characters. Generate e.g. with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
# true in production (HTTPS). false only for local http development.
COOKIE_SECURE=false

# Initial admin account - created on first start ONLY if no admin exists.
# Change the password after first login / remove these afterwards.
ADMIN_NAME=Clinic Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# ---- App ----
SERVER_PORT=8080
# Comma separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Clinic local timezone (IANA id). All appointment dates/times are interpreted in this zone.
APP_TIMEZONE=Asia/Kolkata

# Rate limits (requests per window per client IP)
RATE_LIMIT_BOOKING_PER_HOUR=10
RATE_LIMIT_LOGIN_PER_MINUTE=5
